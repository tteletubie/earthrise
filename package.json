{
  "name": "earthrise-desktop",
  "version": "1.0.0",
  "description": "A basic Electron desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "electron",
    "desktop"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.4.11",
    "electronmon": "^2.0.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@11.10.0": true
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "lucide": "^1.68.0"
  },
  "electronmon": {
    "patterns": [
      "!*.db",
      "!*.db-wal",
      "!*.db-shm"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tteletubie/earthrise.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/tteletubie/earthrise/issues"
  },
  "homepage": "https://github.com/tteletubie/earthrise#readme"
}
