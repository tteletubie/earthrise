{% extends "layouts/app.njk" %}

{% block content %}
    <div class="biblioteca-del-maestro">
        <div class="navegacin-lateral">
            <div class="accesos">
                <div class="identidad-escolar">
                    <div class="smbolo">
                        <i class="book-open-icon" data-lucide="book-open" aria-hidden="true"></i>

                    </div>
                    <div class="nombre">
                        <b class="subttulo">Entre páginas</b>
                        <div class="descripcin">BANCO DE LIBROS ESCOLAR</div>
                    </div>
                </div>
                <div class="men">
                    <div class="etiqueta">ESPACIO ESCOLAR</div>
                    <div class="opcin-de-navegacin">
                        <i class="library-icon" data-lucide="library" aria-hidden="true"></i>

                        <div class="etiqueta2">Biblioteca</div>
                    </div>
                </div>
            </div>
            <div class="sesin">
                <div class="informacin-de-la-escuela">
                    <i class="school-icon" data-lucide="school" aria-hidden="true"></i>

                    <div class="etiqueta">Primaria Los Encinos</div>
                    <div class="descripcin2">Un libro, muchas formas de aprender.</div>
                </div>
                <div class="usuario">
                    <div class="iniciales">
                        <b class="subttulo">
                            {% if usuario %}
                                {{ usuario.nombre | first }}{{ usuario.apellido_paterno | first }}
                            {% else %}
                                --
                            {% endif %}
                        </b>
                    </div>
                    <div class="cuenta">
                        {% if usuario %}
                            <div class="etiqueta5">{{ usuario.nombre }} {{ usuario.apellido_paterno }}</div>
                            <div class="descripcin">Maestro · {{ usuario.grado_nombre }}</div>
                        {% else %}
                            <div class="etiqueta5">Usuario no registrado</div>
                            <div class="descripcin">Completa tu perfil</div>
                        {% endif %}
                    </div>
                </div>
                <div class="cerrar-sesin">
                    <i class="log-out-icon" data-lucide="log-out" aria-hidden="true"></i>

                    <div class="subttulo">Cerrar sesión</div>
                </div>
            </div>
        </div>
        <div class="rea-de-trabajo">
            <div class="barra-superior">
                <div class="descripcin5">Biblioteca escolar / Espacio del maestro</div>
                <div class="maestro-con-verificacion">
                    <div class="etiqueta6">
                        <div class="etiqueta5">Maestro
                            <i class="graduation-cap" data-lucide="graduation-cap" aria-hidden="true"></i>
                        </div>
                    </div>
                    <span class="icono-maestro" role="link" tabindex="0" aria-label="Abrir administración de libros">
                        <i class="log-out-icon" data-lucide="user-round-shield" aria-hidden="true"></i>
                    </span>
                </div>

            </div>
            <div class="catlogo-de-lecturas">
                <div class="encabezado">
                    <div class="ttulo-y-descripcin">
                        <div class="ttulo">Una historia para cada día</div>
                        <div class="descripcin6">
                            {% if usuario %}
                                Hola, {{ usuario.nombre }}. Encuentra la próxima lectura para compartir con tu grupo.
                            {% else %}
                                Hola. Encuentra la próxima lectura para compartir con tu grupo.
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="bsqueda-y-filtros">
                    <div class="campo">
                        <div class="entrada">
                            <i class="search-icon" data-lucide="search" aria-hidden="true"></i>

                            <div class="descripcin7">Buscar por título, autor o palabra clave</div>
                        </div>
                    </div>
                    <div class="campo2">
                        <div class="entrada">
                            <div class="descripcin7">Todos los grados</div>
                            <i class="chevron-down-icon" data-lucide="chevron-down" aria-hidden="true"></i>

                        </div>
                    </div>
                    <div class="campo3">
                        <div class="entrada">
                            <div class="descripcin7">Todas las categorías</div>
                            <i class="chevron-down-icon" data-lucide="chevron-down" aria-hidden="true"></i>

                        </div>
                    </div>
                </div>
                <div class="resumen-del-catlogo">
                    <div class="cantidad-y-disponibilidad">
                        <div class="etiqueta5">10 libros disponibles</div>
                        <div class="descripcin10">Todos incluyen una actividad</div>
                    </div>
                    <div class="orden-del-catlogo">
                        <div class="subttulo">Ordenar: recomendados</div>
                        <i class="chevron-down-icon" data-lucide="chevron-down" aria-hidden="true"></i>

                    </div>
                </div>
                <div class="libros-del-catlogo">
                    <div class="libro-disponible">
                        <div class="presentacin-de-portada">
                            <div class="portada-del-libro">
                                <div class="datos-de-portada">
                                    <b class="etiqueta9">La semilla de Luna</b>
                                    <div class="descripcin12">Elena Ríos</div>
                                </div>
                                <img class="ilustracin-del-cuento" alt="" src="views/home/images/tale-1.jpg">

                            </div>
                        </div>
                        <div class="ficha-breve">
                            <div class="ttulo">La semilla de Luna</div>
                            <div class="descripcin13">Elena Ríos · 10 min de lectura</div>
                        </div>
                        <div class="clasificacin">
                            <div class="etiqueta11">
                                <div class="etiqueta5">2.º grado</div>
                            </div>
                            <div class="etiqueta13">
                                <div class="etiqueta5">Naturaleza</div>
                            </div>
                        </div>
                        <a class="botn" href="#book">
                            <i class="log-out-icon" data-lucide="book-open" aria-hidden="true"></i>

                            <div class="etiqueta5">Ver libro y leer</div>
                        </a>
                    </div>
                    <div class="libro-disponible">
                        <div class="presentacin-de-portada">
                            <div class="portada-del-libro2">
                                <div class="datos-de-portada">
                                    <b class="etiqueta9">El viaje de una gota</b>
                                    <div class="descripcin12">Pablo Montes</div>
                                </div>
                                <img class="ilustracin-del-cuento" alt="" src="views/home/images/tale-2.jpg">

                            </div>
                        </div>
                        <div class="ficha-breve">
                            <div class="ttulo">El viaje de una gota</div>
                            <div class="descripcin13">Pablo Montes · 8 min de lectura</div>
                        </div>
                        <div class="clasificacin">
                            <div class="etiqueta11">
                                <div class="etiqueta5">2.º grado</div>
                            </div>
                            <div class="etiqueta13">
                                <div class="etiqueta5">Ciencia</div>
                            </div>
                        </div>
                        <div class="botn">
                            <i class="log-out-icon" data-lucide="book-open" aria-hidden="true"></i>

                            <div class="etiqueta5">Ver libro y leer</div>
                        </div>
                    </div>
                    <div class="libro-disponible">
                        <div class="presentacin-de-portada">
                            <div class="portada-del-libro3">
                                <div class="datos-de-portada">
                                    <b class="etiqueta9">Un abrazo para erizo</b>
                                    <div class="descripcin12">Lucía Vidal</div>
                                </div>
                                <img class="ilustracin-del-cuento" alt="" src="views/home/images/tale-3.jpg">

                            </div>
                        </div>
                        <div class="ficha-breve">
                            <div class="ttulo">Un abrazo para erizo</div>
                            <div class="descripcin13">Lucía Vidal · 7 min de lectura</div>
                        </div>
                        <div class="clasificacin">
                            <div class="etiqueta11">
                                <div class="etiqueta5">1.º grado</div>
                            </div>
                            <div class="etiqueta13">
                                <div class="etiqueta5">Convivencia</div>
                            </div>
                        </div>
                        <div class="botn">
                            <i class="log-out-icon" data-lucide="book-open" aria-hidden="true"></i>

                            <div class="etiqueta5">Ver libro y leer</div>
                        </div>
                    </div>
                    <div class="libro-disponible">
                        <div class="presentacin-de-portada">
                            <div class="portada-del-libro4">
                                <div class="datos-de-portada">
                                    <b class="etiqueta9">El cielo de Tomás</b>
                                    <div class="descripcin12">Inés Navarro</div>
                                </div>
                                <img class="ilustracin-del-cuento" alt="" src="views/home/images/tale-4.jpg">

                            </div>
                        </div>
                        <div class="ficha-breve">
                            <div class="ttulo">El cielo de Tomás</div>
                            <div class="descripcin13">Inés Navarro · 12 min de lectura</div>
                        </div>
                        <div class="clasificacin">
                            <div class="etiqueta11">
                                <div class="etiqueta5">3.º grado</div>
                            </div>
                            <div class="etiqueta13">
                                <div class="etiqueta5">Imaginación</div>
                            </div>
                        </div>
                        <div class="botn">
                            <i class="log-out-icon" data-lucide="book-open" aria-hidden="true"></i>

                            <div class="etiqueta5">Ver libro y leer</div>
                        </div>
                    </div>
                </div>
                <div class="paginacin">
                    <div class="subttulo">Mostrando 1–4 de 10 libros</div>
                    <div class="pginas-del-catlogo">
                        <div class="botn5">
                            <div class="etiqueta5">Anterior</div>
                        </div>
                        <div class="botn6">
                            <div class="etiqueta5">1</div>
                        </div>
                        <div class="botn7">
                            <div class="etiqueta5">2</div>
                        </div>
                        <div class="botn7">
                            <div class="etiqueta5">3</div>
                        </div>
                        <div class="botn7">
                            <div class="etiqueta5">Siguiente</div>
                        </div>
                    </div>
                </div>
                <div class="gua-para-el-maestro">
                    <i class="messages-square-icon" data-lucide="messages-square" aria-hidden="true"></i>

                    <div class="lectura-en-grupo">
                        <div class="etiqueta">Del cuento a la conversación</div>
                        <div class="descripcin21">Cada libro tiene preguntas para imaginar, comprender y compartir
                            ideas.</div>
                    </div>
                    <div class="etiqueta42">Elige → Proyecta → Conversa</div>
                </div>
            </div>
        </div>
    </div>

    {% if not usuario %}
    <div class="registro-del-maestro" role="dialog" aria-modal="true" aria-labelledby="titulo-registro-maestro">
        <div class="ventana-de-datos-del-maestro">
            <div class="presentacin">
                <div class="espacio-del-maestro">ESPACIO DEL MAESTRO</div>
                <div class="completa-tu-perfil" id="titulo-registro-maestro">Completa tu perfil</div>
                <div class="ingresa-tus-datos">Ingresa tus datos para comenzar a compartir lecturas con tu grupo.</div>
            </div>
            <label class="nombre-del-maestro">
                <span class="nombre-del-maestro2">Nombre del maestro *</span>
                <span class="entrada-de-nombre-del-maestro">
                    <input class="escribe-tu-nombre" name="nombre" placeholder="Escribe tu nombre">
                </span>
            </label>
            <label class="nombre-del-maestro">
                <span class="nombre-del-maestro2">Apellido *</span>
                <span class="entrada-de-nombre-del-maestro">
                    <input class="escribe-tu-nombre" name="apellido" placeholder="Escribe tu apellido">
                </span>
            </label>
            <label class="grado">
                <span class="grado2">Grado *</span>
                <select class="entrada-de-grado" name="grado">
                    <option value="">Selecciona tu grado</option>
                    <option value="1">1°</option>
                    <option value="2">2°</option>
                    <option value="3">3°</option>
                    <option value="4">4°</option>
                    <option value="5">5°</option>
                    <option value="6">6°</option>
                </select>
            </label>
            <div class="acciones">
                <div class="botones">
                    <button class="cancelar" type="button">Cancelar</button>
                    <button class="guardar-y-continuar" type="button">Guardar y continuar</button>
                </div>
                <div class="todos-los-campos">* Todos los campos son obligatorios.</div>
            </div>
        </div>
        {% endif %}
    </div>
{% endblock %}